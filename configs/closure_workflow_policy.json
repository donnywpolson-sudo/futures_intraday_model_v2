{
  "schema_version": "two_tier_workflow_policy/2.0.0",
  "scope": "REPOSITORY_WIDE_TWO_TIER_DEFAULT",
  "normal_local_work": {
    "autonomous": true,
    "actions": [
      "repository_inspection",
      "local_code_and_document_edits",
      "tests",
      "non_research_generated_artifacts",
      "explicit_path_staging",
      "local_commit"
    ],
    "forbidden_shortcuts": ["git add .", "git add -A", "remote_push"]
  },
  "high_risk_work": {
    "requires_plain_language_confirmation": true,
    "confirmation_contents": ["scope", "impact_or_cost", "outputs", "rollback_or_preservation"],
    "actions": [
      "provider_or_network_access",
      "real_data_read_or_evaluation",
      "data_publication_or_active_data_mutation",
      "installation_or_activation",
      "deletion_or_cutover",
      "holdout_or_forward_access",
      "trading_or_order_path",
      "remote_push"
    ]
  },
  "preservation": {
    "historic_workflow_artifacts": "IMMUTABLE_EVIDENCE",
    "accepted_releases": "IMMUTABLE_SUCCESSOR_ONLY",
    "unrelated_worktree_changes": "PRESERVE_AND_EXCLUDE"
  },
  "legacy_closure_workflow": {
    "status": "HISTORIC_EVIDENCE_ONLY",
    "new_plan_generation": false,
    "new_execution": false,
    "new_hash_bound_approval": false
  }
}
