{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "closure_transition_plan/2.0.0",
  "type": "object",
  "required": ["schema_version", "authority_class", "basis", "actions", "limits", "plan_id", "status"],
  "properties": {
    "schema_version": {"const": "closure_transition_plan/2.0.0"},
    "authority_class": {"const": "PROVIDER_FREE_LOCAL_TRANSITION"},
    "basis": {"type": "object"},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type"]}},
    "limits": {"type": "object"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "PENDING_EXACT_APPROVAL"}
  },
  "additionalProperties": true
}
